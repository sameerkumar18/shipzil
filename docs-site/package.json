{
  "name": "shipzil-docs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "python:generate": "uv run --project .. --with ./node_modules/fumadocs-python fumapy-generate shipzil --dir generated && node scripts/generate-python-api.mjs",
    "predev": "npm run python:generate",
    "prebuild": "npm run python:generate",
    "pretypes:check": "npm run python:generate",
    "check:agent": "test -s out/llms.txt && test -s out/llms-full.txt && test -s out/llms.mdx/docs/content.md",
    "build": "next build",
    "dev": "next dev",
    "start": "serve out",
    "types:check": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "cnfast": "^0.1.0",
    "fumadocs-core": "^16.15.4",
    "fumadocs-mdx": "^15.4.0",
    "fumadocs-ui": "^16.15.4",
    "lucide-react": "^1.34.0",
    "next": "16.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "fumadocs-python": "^1.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "postcss": "^8.5.26",
    "serve": "^14.2.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  }
}
